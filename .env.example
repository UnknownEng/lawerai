# ==============================================================================
# LawerAI (Qanoon Sahayak) — Environment Configuration Template
# Copy this file to `.env` for local development or set in your production host
# (Render/Fly.io/Railway/Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Settings
# ------------------------------------------------------------------------------
# Environment: "development" | "staging" | "production"
# Setting to "production" triggers strict security validation (refuses default keys, enforces CORS)
ENVIRONMENT=production

# App branding & debug toggles
APP_NAME="Qanoon Sahayak"
APP_VERSION="1.0.0"
DEBUG=false

# Allowed CORS Origins (comma-separated list of origins permitted to talk to the API)
# In production, DO NOT use "*". Specify your exact frontend URL(s).
ALLOWED_ORIGINS="https://lawerai.vercel.app,https://qanoon-sahayak.vercel.app,http://localhost:5173"

# ------------------------------------------------------------------------------
# 2. Security & Encryption Keys (CRITICAL FOR PRODUCTION)
# ------------------------------------------------------------------------------
# JWT Secret Key for user authentication tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="generate-secure-random-jwt-key-with-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Confidential Citizen Case Data Encryption at Rest (Fernet / AES-128-CBC + HMAC)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CASE_DATA_ENCRYPTION_KEY="generate-secure-fernet-key-with-python-cryptography"

# ------------------------------------------------------------------------------
# 3. Database Connection (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# Production: Managed PostgreSQL (e.g. Neon, Supabase, AWS RDS, Render Postgres)
# Make sure to specify `postgresql+asyncpg://`
DATABASE_URL="postgresql+asyncpg://app_user:strong_password@ep-sample-project.neon.tech/neondb?sslmode=require"

# Local Development SQLite (commented out in production):
# DATABASE_URL="sqlite+aiosqlite:///./data/qanoon_sahayak.db"

# ------------------------------------------------------------------------------
# 4. Evidentiary Document Storage (S3 / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Backend: "local" (development only) | "s3" (production object storage)
STORAGE_BACKEND="s3"

# S3-compatible configuration (Cloudflare R2, AWS S3, Wasabi, or MinIO)
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-s3-or-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-or-r2-secret-access-key"
S3_BUCKET_NAME="lawerai-evidence-uploads"
S3_REGION_NAME="auto"

# ------------------------------------------------------------------------------
# 5. Beta Access Control & Lawyer Review Gate
# ------------------------------------------------------------------------------
# Require invite code for unauthenticated consultation intake
REQUIRE_BETA_CODE=true
BETA_ACCESS_CODE="QANOON-BETA-2026"

# ------------------------------------------------------------------------------
# 6. LLM Model Provider Configuration
# ------------------------------------------------------------------------------
# Selection: "auto" | "gemini" | "claude" | "openai" | "local"
# "local" runs the built-in deterministic statutory reasoning engine without external API fees
LLM_PROVIDER="auto"

# Google Gemini (Recommended for cost-effective beta deployment)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-api03-YourClaudeApiKeyHere"
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# OpenAI GPT
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"
OPENAI_MODEL="gpt-4o"

# ------------------------------------------------------------------------------
# 7. Vector Store & Embeddings
# ------------------------------------------------------------------------------
# Provider: "auto" | "gemini" | "openai" | "local"
# "local" uses hybrid BM25 + dense statutory subword tokenization
EMBEDDING_PROVIDER="auto"

# ------------------------------------------------------------------------------
# 8. Frontend Deployment Variables (Vercel)
# ------------------------------------------------------------------------------
# Points the React frontend build to your hosted FastAPI backend
VITE_API_URL="https://api.yourdomain.com"
